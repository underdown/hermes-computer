{
  "name": "hermes-computer",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat", "experimental"],
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      {
        "name": "AgentDO",
        "class_name": "AgentDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AgentDO"]
    }
  ],
  "containers": [
    {
      "class_name": "AgentDO",
      "image": "./Dockerfile"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
